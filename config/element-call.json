{
  "default_server_config": {
    "m.homeserver": {
      "base_url": "https://interpartes.lo.fi",
      "server_name": "interpartes.lo.fi"
    }
  },
  "ssla": "https://static.element.io/legal/element-software-and-services-license-agreement-uk-1.pdf",
  "matrix_rtc_mode": "compatibility",
  "matrix_rtc_session": {
    "delayed_leave": {
      "delay_ms": 20000,
      "restart_ms": 5000
    },
    "delegated_delayed_leave": {
      "delay_ms": 20000,
      "restart_ms": 5000
    }
  },
  "media_quality": {
    "video_codec": "vp8",
    "video": {
      "max_resolution": 2160,
      "max_bitrate": 8000000,
      "max_framerate": 30
    },
    "screen_share": {
      "max_resolution": 2160,
      "max_bitrate": 12000000,
      "max_framerate": 60,
      "simulcast_layers": [
        {
          "height": 720,
          "bitrate": 2000000,
          "framerate": 30
        },
        {
          "height": 1080,
          "bitrate": 5000000,
          "framerate": 60
        }
      ]
    }
  }
}